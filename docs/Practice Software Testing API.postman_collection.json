{
  "info": {
    "_postman_id": "0c0de75f-d21b-47ce-bcf1-6f87ef639c75",
    "name": "Practice Software Testing API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "53581575"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "   pm.test(\"Status is 200\", function () {\r\n       pm.response.to.have.status(200);\r\n   });\r\n\r\n   const body = pm.response.json();\r\n   pm.test(\"Response contains access token\", function () {\r\n       pm.expect(body).to.have.property(\"access_token\");\r\n   });\r\n   pm.environment.set(\"token\", body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "   {\r\n     \"email\": \"{{email}}\",\r\n     \"password\": \"{{password}}\"\r\n   }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
